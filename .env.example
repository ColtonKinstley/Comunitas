# Local Postgres 18 (Homebrew). Replace `admin` with your macOS user if different.
DATABASE_URL=postgresql://admin@localhost:5432/comunitas

# OpenAI Realtime API key for the voice induction.
# Leave blank here and export it in your shell instead if you prefer:
#   export OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# API server port (web dev server proxies /api here).
PORT=3001
