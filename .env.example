# Local Postgres 18 (Homebrew). Replace `admin` with your macOS user if different.
DATABASE_URL=postgresql://admin@localhost:5432/comunitas

# OpenAI Realtime API key for the voice induction.
# Leave blank here and export it in your shell instead if you prefer:
#   export OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# API server port (web dev server proxies /api here).
PORT=3001

# --- Auth (better-auth) ---
# Origin the app is opened from. Use the tailscale HTTPS origin when demoing on a phone.
BETTER_AUTH_URL=http://localhost:5173
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Google OAuth client (console.cloud.google.com/apis/credentials).
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gates POST/GET/DELETE /api/admin/seed-users. Leave unset to disable the endpoint.
SEED_SECRET=
